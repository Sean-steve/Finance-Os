# Copy to backend/.env for a local development environment only.
# Never commit real passwords, JWT secrets, bank credentials, or connection URLs.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
DATABASE_URL=postgresql://finance_os:CHANGE_ME_LOCAL_ONLY@127.0.0.1:5432/finance_os
# local ONLY; replace the placeholder using a non-committed secret.
DATABASE_SSL_MODE=disable
LOG_LEVEL=info
# Explicit comma-separated allowed origins. GitHub Pages is read-only for now.
CORS_ORIGINS=http://localhost:8080
