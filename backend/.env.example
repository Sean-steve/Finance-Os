NODE_ENV=development
HOST=127.0.0.1
PORT=3101
LOG_LEVEL=info
# Separate restricted database credentials. Run scripts/provision-app-role.sql before connecting.
DATABASE_URL=postgresql://finance_app:APP_PASSWORD@127.0.0.1:5544/finance_os
AUTH_DATABASE_URL=postgresql://finance_auth:AUTH_PASSWORD@127.0.0.1:5544/finance_os
LOCAL_AUTH_ENABLED=true
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
# Never use public demo app credentials, or real bank statements, in local browser storage.

# Optional OIDC provider configuration: mutually exclusive with LOCAL_AUTH_ENABLED.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URI=
OIDC_CLIENT_ID=
OIDC_AUTHORIZATION_ENDPOINT=
OIDC_TOKEN_ENDPOINT=
OIDC_REDIRECT_URI=
OIDC_REQUIRED_ACR=
OIDC_MAX_AUTH_AGE_SECONDS=3600
