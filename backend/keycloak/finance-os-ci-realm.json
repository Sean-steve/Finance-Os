{
  "realm": "finance-os-ci",
  "enabled": true,
  "displayName": "Finance OS Disposable OIDC Certification",
  "sslRequired": "none",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "verifyEmail": false,
  "accessTokenLifespan": 300,
  "loginWithEmailAllowed": true,
  "clients": [
    {
      "clientId": "finance-os-api",
      "name": "Finance OS API audience",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "secret": "ci-issuer-never-used-not-production"
    },
    {
      "clientId": "finance-os-spa",
      "name": "Finance OS Public SPA CI",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://127.0.0.1:8080/connected.html"
      ],
      "webOrigins": [
        "http://127.0.0.1:8080"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "finance-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "finance-os-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "ci-protocol",
      "enabled": true,
      "emailVerified": true,
      "email": "ci-protocol@example.invalid",
      "firstName": "CI",
      "lastName": "Protocol",
      "credentials": [
        {
          "type": "password",
          "value": "CI-ONLY-protocol-password-2026",
          "temporary": false
        }
      ]
    },
    {
      "username": "ci-mfa-required",
      "enabled": true,
      "emailVerified": true,
      "email": "ci-mfa@example.invalid",
      "firstName": "CI",
      "lastName": "MFA",
      "requiredActions": [
        "CONFIGURE_TOTP"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "CI-ONLY-mfa-password-2026",
          "temporary": false
        }
      ]
    }
  ]
}
