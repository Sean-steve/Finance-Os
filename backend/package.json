{
  "name": "@finance-os/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch src/server.mjs",
    "start": "node src/server.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "db:check": "node scripts/migrate.mjs --check",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check src/server.mjs && node --check src/app.mjs && node --check scripts/migrate.mjs && npm test"
  },
  "dependencies": {
    "fastify": "^5.2.0",
    "pg": "^8.13.3"
  },
  "devDependencies": {}
}
