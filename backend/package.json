{
  "name": "@finance-os/backend",
  "version": "0.9.1",
  "private": true,
  "type": "module",
  "description": "Finance OS B8.1 staging deployment, dedicated PostgreSQL certification and evidence-gated production activation",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test test/unit.test.ts test/contracts.test.ts test/auth.test.ts test/oidc.test.ts test/b2.unit.test.ts test/b3.unit.test.ts test/b4.unit.test.ts test/b5.unit.test.ts test/b6.unit.test.ts test/b7.unit.test.ts",
    "test:db": "tsx --test test/database.test.ts",
    "migrate": "tsx src/db/migrate.ts",
    "contract:check": "tsx test/check-openapi.ts",
    "test:b1": "tsx --test test/b1.integration.test.ts",
    "test:oidc": "tsx --test test/oidc.test.ts",
    "test:oidc:db": "tsx --test test/oidc.integration.test.ts",
    "test:b2": "tsx --test test/b2.integration.test.ts",
    "test:b3": "tsx --test test/b3.integration.test.ts",
    "test:b4": "tsx --test test/b4.integration.test.ts",
    "test:b5": "tsx --test test/b5.integration.test.ts",
    "test:b6": "tsx --test test/b6.integration.test.ts",
    "test:b7": "tsx --test test/b7.integration.test.ts",
    "test:b8": "tsx --test test/b8.integration.test.ts",
    "release:gate": "node scripts/release-gate.mjs",
    "test:staging": "node --test test/staging-readiness.test.mjs test/staging-package.test.mjs",
    "test:staging:db": "node --test test/staging-db.integration.test.mjs",
    "staging:preflight": "node scripts/staging-readiness.mjs",
    "staging:probe": "node scripts/staging-readiness.mjs --probe",
    "staging:prepare": "node scripts/staging-prepare.mjs",
    "staging:db:certify": "node scripts/staging-db-certify.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "fastify": "^5.5.0",
    "pg": "^8.16.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@apidevtools/swagger-parser": "^10.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
