  "designRules": {
    "noNumbersInNavigation": true,
    "noAuthOrOnboardingInAuthenticatedMenu": true,
    "realMoneyProvenanceRequired": true,
    "suppressUnverifiedAvailableToSpend": true,
    "noSyntheticFinancialRecordsInAuthenticatedUI": true,
    "showEmptyAndUnavailableStates": true,
    "settingsNeverHoldsFullProductFunctionality": true,
    "lowFrictionPrimaryAction": true,
    "chartsRequireDataSourceAndTimeRange": true
  },
  "flowRules": [
    {
      "capability": "transfers",
      "implementation": "BLOCKED",
      "reason": "Ledger-backed financial transfers not available"
    },
    {
      "capability": "provider_connections",
      "implementation": "BLOCKED",
      "reason": "No live M-Pesa/bank provider integration"
    },
    {
      "capability": "payments",
      "implementation": "BLOCKED",
      "reason": "Bill settlement records are not provider receipts"
    },
    {
      "capability": "AI advice",
      "implementation": "RULES_ONLY",
      "reason": "No generative AI provider; explanatory heuristics only"
    },
    {
      "capability": "savings_buckets",
      "implementation": "VIRTUAL_ONLY",
      "reason": "No fund custody or actual transfer"
    },
    {
      "capability": "financial_integrity",
      "implementation": "MANUAL_LEDGER_ONLY",
      "reason": "Not independently bank reconciled"
    }
  ]
